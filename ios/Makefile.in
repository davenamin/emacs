### Commentary:

## This Makefile assembles the iOS application bundle (Emacs.app)
## from the bundle template at ios/Emacs.base/ and the cross-compiled
## emacs binary produced by the iOS variant of src/Makefile.  It
## follows the same pattern as nextstep/Makefile.in.
##
## The cross-build of the emacs binary itself (driven by
## cross/xcode-build/) is added in a follow-up commit; until then
## `make -C ios all' will report a clear error if invoked without the
## cross-compiled binary in place.

### Code:

SHELL = @SHELL@
srcdir = @srcdir@
abs_builddir = @abs_builddir@
abs_top_builddir = @abs_top_builddir@
abs_top_srcdir = @abs_top_srcdir@
MKDIR_P = @MKDIR_P@

## Output bundle path.
ios_appdir = @ios_appdir@
ios_appsrc = Emacs.base

## Provenance of the Emacs Mach-O for iOS.  Produced by the cross-
## build harness in cross/, which consumes the *.ios artifacts that
## the recursive XCONFIGURE=ios configure pass emitted into
## src/Makefile.ios, src/config.h.ios, lib/Makefile.ios, etc.
ios_emacs_binary = $(abs_top_builddir)/cross/src/emacs

## Code-signing identity.  When unset, the build produces an
## unsigned bundle suitable for the Simulator only.  Real device
## builds also need PROVISIONING_PROFILE and DEVICE_ENTITLEMENTS;
## see "Installing on a physical device" in ios/README.
CODESIGN_IDENTITY ?=

.PHONY: all
all: $(ios_appdir)/emacs

## Step 1: assemble the bundle template into $(ios_appdir).  Mirrors
## the tar-based dance in nextstep/Makefile.in.  Info.plist is
## generated by configure (from Info.plist.in) into the build tree at
## $(builddir)/Emacs.base/Info.plist and copied in here.
$(ios_appdir): $(srcdir)/$(ios_appsrc) Emacs.base/Info.plist
	rm -rf $(ios_appdir)
	$(MKDIR_P) $(ios_appdir)
	( cd $(srcdir)/$(ios_appsrc) ; tar cfh - \
	    --exclude Info.plist.in . ) | \
	  ( cd $(ios_appdir) ; umask 022; tar xf - )
	cp Emacs.base/Info.plist $(ios_appdir)/Info.plist
	touch $(ios_appdir)

## Step 1b: copy the Lisp tree and data files into the bundle.  iOS
## apps run from a sandboxed location with no /usr/local, so the
## install-prefix-relative default paths Emacs hard-codes are useless.
## ios.m sets EMACSLOADPATH and EMACSDATA from the bundle path at
## launch so loadup.el and etc/ resolve here.
##
## Use rsync (preinstalled on macOS runners) to copy the trees;
## tar-pipe would also work but rsync gives a clean exclude rule for
## the Makefile / .gitignore noise.
$(ios_appdir)/lisp/loadup.el: $(ios_appdir)
	rsync -a --delete \
	  --exclude='*.elc' --exclude='.git*' --exclude='Makefile*' \
	  $(abs_top_srcdir)/lisp/ $(ios_appdir)/lisp/
	touch $@

$(ios_appdir)/etc/charsets: $(ios_appdir)
	rsync -a --delete \
	  --exclude='.git*' --exclude='Makefile*' --exclude='emacs.1' \
	  $(abs_top_srcdir)/etc/ $(ios_appdir)/etc/
	touch $@ || true

## Step 2: drop the cross-compiled emacs binary into the bundle and
## codesign.  Depend on the Lisp + data copy so an `all' build
## produces a runnable bundle in one shot.
$(ios_appdir)/emacs: $(ios_appdir) $(ios_emacs_binary) \
                     $(ios_appdir)/lisp/loadup.el \
                     $(ios_appdir)/etc/charsets
	cp -f $(ios_emacs_binary) $@
	@if [ -n "$(CODESIGN_IDENTITY)" ]; then \
	  codesign --force --sign $(CODESIGN_IDENTITY) $(ios_appdir); \
	else \
	  echo "ios/Makefile: CODESIGN_IDENTITY unset; producing"; \
	  echo "  unsigned bundle suitable for the Simulator only."; \
	fi

## Fallback rule for $(ios_emacs_binary): make -C cross all is what
## produces this file from the *.ios artifacts.  If it's missing we
## emit a diagnostic that points at the correct top-level entry point
## rather than make's default "no rule to make target" message.
$(ios_emacs_binary):
	@echo "ios/Makefile: cannot find iOS-targeted emacs binary at"
	@echo "  $(ios_emacs_binary)"
	@echo ""
	@echo "Build it via 'make -C .. ios' from the top-level build"
	@echo "directory (which runs 'make -C cross all' before assembling"
	@echo "the bundle), or run 'make -C ../cross all' directly."
	@exit 1

## Emacs.base/Info.plist is generated by configure (see
## AC_CONFIG_FILES in configure.ac); no rule needed here.

.PHONY: clean distclean bootstrap-clean maintainer-clean
clean:
	rm -rf $(ios_appdir)

distclean: clean
	rm -f Makefile Emacs.base/Info.plist

bootstrap-clean maintainer-clean: distclean

### Makefile.in ends here
