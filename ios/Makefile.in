### Commentary:

## This Makefile assembles the iOS application bundle (Emacs.app)
## from the bundle template at ios/Emacs.base/ and the cross-compiled
## emacs binary produced by the iOS variant of src/Makefile.  It
## follows the same pattern as nextstep/Makefile.in.
##
## The cross-build of the emacs binary itself (driven by
## cross/xcode-build/) is added in a follow-up commit; until then
## `make -C ios all' will report a clear error if invoked without the
## cross-compiled binary in place.

### Code:

SHELL = @SHELL@
srcdir = @srcdir@
abs_builddir = @abs_builddir@
abs_top_builddir = @abs_top_builddir@
abs_top_srcdir = @abs_top_srcdir@
MKDIR_P = @MKDIR_P@

## Output bundle path.
ios_appdir = @ios_appdir@
ios_appsrc = Emacs.base

## Provenance of the Emacs Mach-O for iOS.  This file is produced by
## the recursive XCONFIGURE=ios configure pass plus
## cross/xcode-build/, neither of which has landed yet; for now the
## variable points at a path that does not exist on a non-iOS build.
ios_emacs_binary = $(abs_top_builddir)/src/emacs

## Code-signing identity.  When unset, the build will produce an
## unsigned .app suitable for the Simulator only.
CODESIGN_IDENTITY ?=

## Path to the entitlements file copied into the bundle.
entitlements = $(srcdir)/$(ios_appsrc)/Emacs.entitlements

.PHONY: all
all: $(ios_appdir)/emacs

## Step 1: assemble the bundle template into $(ios_appdir).  Mirrors
## the tar-based dance in nextstep/Makefile.in.  Info.plist is
## generated by configure (from Info.plist.in) into the build tree at
## $(builddir)/Emacs.base/Info.plist; the entitlements file is not
## copied into the bundle (codesign reads it via --entitlements).
$(ios_appdir): $(srcdir)/$(ios_appsrc) Emacs.base/Info.plist
	rm -rf $(ios_appdir)
	$(MKDIR_P) $(ios_appdir)
	( cd $(srcdir)/$(ios_appsrc) ; tar cfh - \
	    --exclude Info.plist.in --exclude Emacs.entitlements . ) | \
	  ( cd $(ios_appdir) ; umask 022; tar xf - )
	cp Emacs.base/Info.plist $(ios_appdir)/Info.plist
	touch $(ios_appdir)

## Step 2: drop the cross-compiled emacs binary into the bundle and
## codesign.
$(ios_appdir)/emacs: $(ios_appdir) $(ios_emacs_binary)
	cp -f $(ios_emacs_binary) $@
	@if [ -n "$(CODESIGN_IDENTITY)" ]; then \
	  codesign --force --sign $(CODESIGN_IDENTITY) \
	    --entitlements $(entitlements) $(ios_appdir); \
	else \
	  echo "ios/Makefile: CODESIGN_IDENTITY unset; producing"; \
	  echo "  unsigned bundle suitable for the Simulator only."; \
	fi

## Fallback rule for $(ios_emacs_binary): the iOS cross-build
## infrastructure that produces this file hasn't been wired into
## configure.ac yet (it will be added in a follow-up commit).  Until
## then, fire a clear diagnostic instead of make's default "no rule
## to make target" message.
$(ios_emacs_binary):
	@echo "ios/Makefile: cannot find iOS-targeted emacs binary at"
	@echo "  $(ios_emacs_binary)"
	@echo ""
	@echo "The recursive XCONFIGURE=ios cross-configure step that"
	@echo "produces this binary has not yet been wired into"
	@echo "configure.ac.  Until that follow-up commit lands, only"
	@echo "the bundle template assembly works (and has succeeded)."
	@exit 1

## Emacs.base/Info.plist is generated by configure (see
## AC_CONFIG_FILES in configure.ac); no rule needed here.

.PHONY: clean distclean bootstrap-clean maintainer-clean
clean:
	rm -rf $(ios_appdir)

distclean: clean
	rm -f Makefile Emacs.base/Info.plist

bootstrap-clean maintainer-clean: distclean

### Makefile.in ends here
