### Commentary:

## This Makefile assembles the iOS application bundle (Emacs.app)
## from the bundle template at ios/Emacs.base/ and the cross-compiled
## emacs binary produced by the iOS variant of src/Makefile.  It
## follows the same pattern as nextstep/Makefile.in.
##
## The emacs binary itself is produced by the cross-build harness
## in cross/, driven from the top-level ios target.

### Code:

SHELL = @SHELL@
srcdir = @srcdir@
abs_builddir = @abs_builddir@
abs_top_builddir = @abs_top_builddir@
abs_top_srcdir = @abs_top_srcdir@
MKDIR_P = @MKDIR_P@

## Output bundle path.
ios_appdir = @ios_appdir@
ios_appsrc = Emacs.base

## Platform inputs consumed by the actool app-icon step.
ios_platform = @IOS_PLATFORM_SDK@
ios_min_version = @IOS_DEPLOYMENT_TARGET@

## App icon artwork.  Not shipped in the repository -- App Store
## submissions need original artwork.  Drop a 1024x1024 PNG at this
## path and the bundle step compiles the asset catalog with actool
## and wires CFBundleIconName into the bundle's Info.plist.  When
## absent, the step is skipped and the app shows the system's blank
## placeholder icon (fine for Simulator / device development; App
## Store validation rejects icon-less submissions).
##
## Alternatively pass IOS_APP_ICON=/path/to/icon.png on the make
## command line (make ios IOS_APP_ICON=...) to use artwork kept
## outside the source tree; the recipe assembles a build-dir asset
## catalog around it.  Either way the PNG must be 1024x1024, opaque,
## and without alpha for App Store acceptance.
ios_icon_png = $(if $(IOS_APP_ICON),$(IOS_APP_ICON),$(srcdir)/$(ios_appsrc)/Assets.xcassets/AppIcon.appiconset/AppIcon.png)

## Provenance of the Emacs Mach-O for iOS.  Produced by the cross-
## build harness in cross/, which consumes the *.ios artifacts that
## the recursive XCONFIGURE=ios configure pass emitted into
## src/Makefile.ios, src/config.h.ios, lib/Makefile.ios, etc.
ios_emacs_binary = $(abs_top_builddir)/cross/src/emacs

## Code-signing identity.  When unset, the build produces an
## unsigned bundle suitable for the Simulator only.  Real device
## builds also need PROVISIONING_PROFILE and DEVICE_ENTITLEMENTS;
## see "Installing on a physical device" in ios/README.
CODESIGN_IDENTITY ?=

## Device-build inputs.  Optional; both must be set together.  When
## PROVISIONING_PROFILE is set, the file is copied into the bundle
## root as embedded.mobileprovision BEFORE codesign runs -- Apple's
## published signing engine
## (apple-oss-distributions/Security: libsecurity_codesigning,
## bundlediskrep.cpp defaultResourceRules) seals every bundle file
## under its V2 catch-all rule, so the profile must be in place
## before signing or the seal is invalid.
##
## When DEVICE_ENTITLEMENTS is set, codesign embeds that plist
## verbatim into the signature's entitlement slot (slot 5 + DER
## copy in slot 7) per the same engine source -- no merging with
## any other source.  The plist is constructed from the profile's
## Entitlements dict; use the device-entitlements-template target
## to extract a starting point.
PROVISIONING_PROFILE ?=
DEVICE_ENTITLEMENTS  ?=

.PHONY: all
all: sign

## Step 1: assemble the bundle template into $(ios_appdir).  Mirrors
## the tar-based dance in nextstep/Makefile.in.  Info.plist is
## generated by configure (from Info.plist.in) into the build tree at
## $(builddir)/Emacs.base/Info.plist and copied in here.
$(ios_appdir): $(srcdir)/$(ios_appsrc) Emacs.base/Info.plist
	rm -rf $(ios_appdir)
	$(MKDIR_P) $(ios_appdir)
	( cd $(srcdir)/$(ios_appsrc) ; tar cfh - \
	    --exclude Info.plist.in --exclude Assets.xcassets \
	    --exclude LaunchScreen.storyboard . ) | \
	  ( cd $(ios_appdir) ; umask 022; tar xf - )
	cp Emacs.base/Info.plist $(ios_appdir)/Info.plist
	## Toolchain-provenance keys App Store ingestion expects on
	## every upload (Xcode stamps them itself; a Makefile build
	## must add them or validation rejects with the ITMS-90530
	## family).  DTXcode is the version with the dots removed,
	## zero-padded to at least four digits (26.5 -> 2650).
	sdk_ver=`xcrun --sdk $(ios_platform) --show-sdk-version`; \
	sdk_build=`xcrun --sdk $(ios_platform) --show-sdk-build-version`; \
	xc_ver=`xcodebuild -version | sed -n 's/^Xcode //p'`; \
	xc_build=`xcodebuild -version | sed -n 's/^Build version //p'`; \
	dtxcode=`echo $$xc_ver | awk -F. \
	  '{ printf "%s%s%s", $$1, $$2, ($$3 == "" ? "0" : $$3) }'`; \
	os_build=`sw_vers -buildVersion`; \
	set -e; \
	for kv in \
	  "DTSDKName=$(ios_platform)$$sdk_ver" \
	  "DTPlatformVersion=$$sdk_ver" \
	  "DTSDKBuild=$$sdk_build" \
	  "DTPlatformBuild=$$sdk_build" \
	  "DTXcode=$$dtxcode" \
	  "DTXcodeBuild=$$xc_build" \
	  "DTCompiler=com.apple.compilers.llvm.clang.1_0" \
	  "BuildMachineOSBuild=$$os_build"; do \
	  key=$${kv%%=*}; val=$${kv#*=}; \
	  /usr/libexec/PlistBuddy \
	    -c "Delete :$$key" "$(ios_appdir)/Info.plist" \
	    2>/dev/null || true; \
	  /usr/libexec/PlistBuddy \
	    -c "Add :$$key string $$val" "$(ios_appdir)/Info.plist"; \
	done
	## iOS loads only COMPILED storyboards (.storyboardc).  Shipping
	## the raw XML source leaves the app without a loadable launch
	## screen, and devices then run it under legacy compatibility
	## scaling: rendered at a small logical size and scaled up --
	## oversized-looking fonts and a letterboxed, non-fullscreen
	## window.  (The Simulator is forgiving here and loads the raw
	## XML, so only real devices show the failure.)
	xcrun ibtool --compile $(ios_appdir)/LaunchScreen.storyboardc \
	  --module Emacs --auto-activate-custom-fonts \
	  --target-device iphone --target-device ipad \
	  --minimum-deployment-target $(ios_min_version) \
	  $(srcdir)/$(ios_appsrc)/LaunchScreen.storyboard
	touch $(ios_appdir)

## Step 1b: copy the Lisp tree and data files into the bundle.  iOS
## apps run from a sandboxed location with no /usr/local, so the
## install-prefix-relative default paths Emacs hard-codes are useless.
## ios.m sets EMACSLOADPATH and EMACSDATA from the bundle path at
## launch so loadup.el and etc/ resolve here.
##
## Use rsync to copy the trees; tar-pipe would also work but rsync
## gives a clean exclude rule for the Makefile / .gitignore noise.
##
## The $(wildcard) prerequisite makes the copy re-run whenever the
## host build regenerates loaddefs.el (a staleness proxy for the
## whole family of generated autoload files); when the file has
## never been generated the wildcard is empty and the recipe check
## below reports the problem instead of shipping a bundle whose
## loadup would fall back to the outdated ldefs-boot.el, leaving
## every newer autoload undefined.
## The self-tests and the font demo are development aids: one writes
## a results file for an automated run to check, the other fills a
## buffer with sample text to be looked at.  Neither belongs in an app
## someone installs, so lisp/term/ios-tests.el is left out unless
## IOS_SELFTESTS is yes.  ios-win.el registers the autoloads for the
## two commands only when the file is present, so with it excluded
## they are not offered either.
IOS_SELFTESTS = no
ifeq ($(IOS_SELFTESTS),yes)
ios_selftest_exclude =
else
ios_selftest_exclude = --exclude=term/ios-tests.el
endif

## Upstream ERT suites to run inside the simulator alongside the
## port's own probes, and the data directories two of them read.
## Chosen for being pure Lisp: iOS has no fork or exec, no network,
## and a filesystem confined to the container, so anything driving a
## subprocess or reaching outside is unrunnable.  These travel under
## the same IOS_SELFTESTS switch as ios-tests.el, so no bundle
## anyone installs carries them.
## The src/ suites carry the most weight for a port: they exercise
## the C layer, which is where a new platform diverges.  Suites that
## drive subprocesses (process, callproc, emacs), load modules
## (emacs-module), or need features iOS does not build (comp, lcms,
## treesit grammars) are absent because they cannot run here at all.
## ert-tests and ert-x-tests are absent for a different reason: they
## exercise ERT itself, and the runner in ios-tests.el is an
## ert-select-tests loop that they would be manipulating.
ios_ert_tests =					\
  lisp/emacs-lisp/seq-tests.el			\
  lisp/emacs-lisp/cl-lib-tests.el		\
  lisp/emacs-lisp/subr-x-tests.el		\
  lisp/faces-tests.el				\
  src/alloc-tests.el				\
  src/buffer-tests.el				\
  src/callint-tests.el				\
  src/casefiddle-tests.el			\
  src/character-tests.el			\
  src/charset-tests.el				\
  src/chartab-tests.el				\
  src/cmds-tests.el				\
  src/coding-tests.el				\
  src/data-tests.el				\
  src/doc-tests.el				\
  src/fileio-tests.el				\
  src/floatfns-tests.el				\
  src/fns-tests.el				\
  src/font-tests.el				\
  src/image-tests.el				\
  src/indent-tests.el				\
  src/json-tests.el				\
  src/keymap-tests.el				\
  src/lread-tests.el				\
  src/marker-tests.el				\
  src/minibuf-tests.el				\
  src/print-tests.el				\
  src/regex-emacs-tests.el			\
  src/search-tests.el				\
  src/sqlite-tests.el				\
  src/syntax-tests.el				\
  src/textprop-tests.el				\
  src/thread-tests.el				\
  src/timefns-tests.el				\
  src/undo-tests.el				\
  src/xdisp-tests.el				\
  src/xfaces-tests.el				\
  src/xml-tests.el
ios_ert_resources =				\
  lisp/faces-resources				\
  src/lread-resources				\
  src/regex-resources				\
  src/syntax-resources

$(ios_appdir)/lisp/loadup.el: $(ios_appdir) \
    $(wildcard $(abs_top_srcdir)/lisp/loaddefs.el)
	@test -f $(abs_top_srcdir)/lisp/loaddefs.el || { \
	  echo "ios/Makefile: lisp/loaddefs.el has not been generated."; \
	  echo "  Run 'make ios' from the top-level build directory;"; \
	  echo "  it builds the host bootstrap-emacs and the autoload"; \
	  echo "  files before assembling the bundle."; \
	  exit 1; }
	rsync -a --delete \
	  --exclude='*.elc' --exclude='.git*' --exclude='Makefile*' \
	  $(ios_selftest_exclude) \
	  $(abs_top_srcdir)/lisp/ $(ios_appdir)/lisp/
	## subdirs.el is generated by the normal build, not stored in
	## the source tree, so the rsync above never ships it -- and
	## without it startup.el's normal-top-level never extends
	## load-path into lisp/mail, lisp/net, lisp/emacs-lisp, etc.,
	## so nothing outside the preloaded set can be loaded.
	## Generate the standard one-liner form.
	printf '%s\n%s\n' \
	  ';; -*- no-byte-compile: t -*-' \
	  "(if (fboundp 'normal-top-level-add-subdirs-to-load-path) (normal-top-level-add-subdirs-to-load-path))" \
	  > $(ios_appdir)/lisp/subdirs.el
	## The ERT suites, under the same switch.  The unconditional
	## removal in the else branch matters: without it a bundle
	## built for the simulator and then rebuilt for a device would
	## keep the tests it was no longer supposed to have.
	@if [ "$(IOS_SELFTESTS)" = yes ]; then \
	  set -e; \
	  for f in $(ios_ert_tests) $(ios_ert_resources); do \
	    $(MKDIR_P) "$(ios_appdir)/test/`dirname $$f`"; \
	    rm -rf "$(ios_appdir)/test/$$f"; \
	    cp -R "$(abs_top_srcdir)/test/$$f" "$(ios_appdir)/test/$$f"; \
	  done; \
	  echo "ios/Makefile: shipped ERT suites for the simulator"; \
	else \
	  rm -rf "$(ios_appdir)/test"; \
	fi
	touch $@

$(ios_appdir)/etc/charsets: $(ios_appdir)
	rsync -a --delete \
	  --exclude='.git*' --exclude='Makefile*' --exclude='emacs.1' \
	  $(abs_top_srcdir)/etc/ $(ios_appdir)/etc/
	## TLS trust anchors.  iOS has no /etc/ssl and GnuTLS is built
	## without a default trust store, so export Apple's root-CA set
	## from the build host into the bundle; ios-win.el points
	## gnutls-trustfiles here.  Exported unconditionally -- it is a
	## few hundred KB and forward-compatible with TLS-less builds.
	## security(1) is part of macOS; find-certificate -a -p emits
	## every certificate in the keychain as PEM.
	security find-certificate -a -p \
	  /System/Library/Keychains/SystemRootCertificates.keychain \
	  > $(ios_appdir)/etc/ca-bundle.pem
	## tree-sitter grammar directory (treesit-extra-load-path points
	## here).  Seeded from $(ios_appsrc)/tree-sitter if the builder
	## provides pre-built, iOS-arm64 grammar dylibs there; otherwise
	## left empty -- grammars cannot be installed at runtime on iOS
	## (see ios/README).
	$(MKDIR_P) $(ios_appdir)/tree-sitter
	if [ -d "$(srcdir)/$(ios_appsrc)/tree-sitter" ]; then \
	  cp -f $(srcdir)/$(ios_appsrc)/tree-sitter/*.dylib \
	    $(ios_appdir)/tree-sitter/ 2>/dev/null || true; \
	fi
	## DOC (built-in docstrings) is generated into cross/etc by
	## the top-level ios target; without it C-h on any C-level
	## function or variable fails.  The Info manuals land in
	## <srcdir>/info via make info.  ios.m points EMACSDOC and
	## INFOPATH at these bundle locations.
	@if [ -f "$(abs_top_builddir)/cross/etc/DOC" ]; then \
	  cp -f "$(abs_top_builddir)/cross/etc/DOC" \
	    "$(ios_appdir)/etc/DOC"; \
	else \
	  echo "ios/Makefile: cross/etc/DOC missing; C-h for" ; \
	  echo "  built-ins will fail.  Run make ios from the top" ; \
	  echo "  level to generate it." ; \
	fi
	@if [ -f "$(abs_top_srcdir)/info/dir" ]; then \
	  rsync -a --delete --exclude='.git*' \
	    "$(abs_top_srcdir)/info/" "$(ios_appdir)/info/"; \
	else \
	  echo "ios/Makefile: <srcdir>/info missing; Info manuals" ; \
	  echo "  will be absent.  Run make ios from the top level" ; \
	  echo "  to generate them." ; \
	fi
	touch $@ || true

## Step 2: drop the cross-compiled emacs binary into the bundle and
## compile the icon asset catalog.  Depend on the Lisp + data copy so
## an `all' build produces a runnable bundle in one shot.  Signing is
## step 3, and is not part of this rule; see the comment there.
$(ios_appdir)/emacs: $(ios_appdir) $(ios_emacs_binary) \
                     $(ios_appdir)/lisp/loadup.el \
                     $(ios_appdir)/etc/charsets
	cp -f $(ios_emacs_binary) $@
	## actool reports errors on stdout and can exit 0 while doing
	## so; the icon step below therefore logs actool's output and
	## treats the run as failed unless the compiled Assets.car
	## landed in the bundle and the partial plist parses, printing
	## the log in that case.  (The icon keys sit nested under
	## CFBundleIcons/CFBundlePrimaryIcon in the partial plist, so
	## probing a top-level key is not a valid success check.)
	@if [ -f "$(ios_icon_png)" ]; then \
	  echo "ios/Makefile: compiling app icon asset catalog"; \
	  catalog="$(srcdir)/$(ios_appsrc)/Assets.xcassets"; \
	  if [ -n "$(IOS_APP_ICON)" ]; then \
	    if [ ! -f "$(IOS_APP_ICON)" ]; then \
	      echo "ios/Makefile: IOS_APP_ICON not found: $(IOS_APP_ICON)" >&2; \
	      echo "  Use an absolute path; make does not expand ~." >&2; \
	      exit 1; \
	    fi; \
	    catalog="$(abs_builddir)/Assets.xcassets"; \
	    { rm -rf "$$catalog" \
	      && mkdir -p "$$catalog/AppIcon.appiconset" \
	      && cp "$(srcdir)/$(ios_appsrc)/Assets.xcassets/Contents.json" \
	           "$$catalog/Contents.json" \
	      && cp "$(srcdir)/$(ios_appsrc)/Assets.xcassets/AppIcon.appiconset/Contents.json" \
	           "$$catalog/AppIcon.appiconset/Contents.json" \
	      && cp "$(IOS_APP_ICON)" \
	           "$$catalog/AppIcon.appiconset/AppIcon.png"; } \
	      || { echo "ios/Makefile: assembling icon catalog failed" >&2; \
	           exit 1; }; \
	  fi; \
	  rm -f "$(abs_builddir)/actool-partial.plist"; \
	  xcrun actool --compile "$(ios_appdir)" \
	    --output-partial-info-plist \
	      "$(abs_builddir)/actool-partial.plist" \
	    --app-icon AppIcon \
	    --platform $(ios_platform) \
	    --minimum-deployment-target $(ios_min_version) \
	    "$$catalog" \
	    > "$(abs_builddir)/actool.log" 2>&1; \
	  actool_status=$$?; \
	  if [ $$actool_status -ne 0 ] \
	     || [ ! -f "$(ios_appdir)/Assets.car" ] \
	     || ! /usr/libexec/PlistBuddy -c 'Print' \
	            "$(abs_builddir)/actool-partial.plist" \
	            >/dev/null 2>&1; then \
	    echo "ios/Makefile: actool failed; its output follows:" >&2; \
	    cat "$(abs_builddir)/actool.log" >&2; \
	    exit 1; \
	  fi; \
	  for key in CFBundleIconName CFBundleIcons \
	             'CFBundleIcons~ipad' CFBundlePrimaryIcon; do \
	    /usr/libexec/PlistBuddy -c "Delete :$$key" \
	      "$(ios_appdir)/Info.plist" 2>/dev/null || true; \
	  done; \
	  /usr/libexec/PlistBuddy -c \
	    "Merge $(abs_builddir)/actool-partial.plist" \
	    "$(ios_appdir)/Info.plist"; \
	else \
	  echo "ios/Makefile: no AppIcon.png; skipping asset catalog"; \
	  echo "  (App Store submissions require one; see ios/README)"; \
	fi

## Step 3: code-sign the bundle.  Deliberately a phony target rather
## than part of step 2.  Every input to signing is either a
## command-line variable (CODESIGN_IDENTITY) or a file outside the
## bundle (PROVISIONING_PROFILE, DEVICE_ENTITLEMENTS), and make can
## compare none of those against the bundle's timestamp.  Folded into
## the step 2 file rule, "make ipa CODESIGN_IDENTITY=..." was a no-op
## whenever the bundle happened to be up to date: it repackaged an
## older signature, or none, without saying so.
.PHONY: sign
sign: $(ios_appdir)/emacs
	@if [ -z "$(CODESIGN_IDENTITY)" ]; then \
	  rm -rf "$(ios_appdir)/_CodeSignature" \
	         "$(ios_appdir)/embedded.mobileprovision"; \
	  echo "ios/Makefile: CODESIGN_IDENTITY unset; producing"; \
	  echo "  unsigned bundle suitable for the Simulator only."; \
	  exit 0; \
	fi; \
	set -e; \
	if [ -n "$(PROVISIONING_PROFILE)" ]; then \
	  cp -f "$(PROVISIONING_PROFILE)" \
	    "$(ios_appdir)/embedded.mobileprovision"; \
	elif [ -f "$(ios_appdir)/embedded.mobileprovision" ]; then \
	  echo "ios/Makefile: the bundle carries an" >&2; \
	  echo "  embedded.mobileprovision from an earlier build, but" >&2; \
	  echo "  PROVISIONING_PROFILE is unset, so signing now would" >&2; \
	  echo "  pair this identity with a profile you did not name." >&2; \
	  echo "  Pass PROVISIONING_PROFILE, or delete that file." >&2; \
	  exit 1; \
	fi; \
	for dylib in $(ios_appdir)/tree-sitter/*.dylib; do \
	  [ -f "$$dylib" ] || continue; \
	  codesign --force --sign "$(CODESIGN_IDENTITY)" "$$dylib"; \
	done; \
	if [ -n "$(DEVICE_ENTITLEMENTS)" ]; then \
	  codesign --force --sign "$(CODESIGN_IDENTITY)" \
	    --entitlements "$(DEVICE_ENTITLEMENTS)" "$(ios_appdir)"; \
	else \
	  codesign --force --sign "$(CODESIGN_IDENTITY)" "$(ios_appdir)"; \
	fi; \
	codesign --verify --strict "$(ios_appdir)"
	@$(MAKE) check-signing-matches-profile

## Reject locally what App Store Connect would reject on upload: a
## bundle whose signing certificate is absent from the
## DeveloperCertificates array of its own embedded.mobileprovision.
## Transporter reports that as "Invalid Code Signing ... must be
## signed with the certificate that is contained in the provisioning
## profile", after the archive has been uploaded; the same comparison
## costs a second here.  Certificates are matched by SHA-1
## fingerprint, not by name, because the display names of a renewed
## and a revoked certificate are identical.
.PHONY: check-signing-matches-profile
check-signing-matches-profile:
	@test -f "$(ios_appdir)/embedded.mobileprovision" || exit 0; \
	set -e; \
	tmpd=`mktemp -d -t emacs-sign`; \
	trap 'rm -rf "$$tmpd"' 0 1 2 3 15; \
	codesign -d --extract-certificates="$$tmpd/sig" \
	  "$(ios_appdir)" 2>/dev/null || true; \
	test -f "$$tmpd/sig0" || { \
	  echo "ios/Makefile: the bundle carries a provisioning" >&2; \
	  echo "  profile but is not signed." >&2; \
	  exit 1; }; \
	signer=`openssl x509 -inform DER -in "$$tmpd/sig0" -noout \
	          -fingerprint -sha1 | sed 's/.*=//'`; \
	security cms -D -i "$(ios_appdir)/embedded.mobileprovision" \
	  -o "$$tmpd/profile.plist"; \
	i=0; match=no; \
	while [ $$i -lt 20 ]; do \
	  plutil -extract DeveloperCertificates.$$i raw -o "$$tmpd/c.b64" \
	    "$$tmpd/profile.plist" 2>/dev/null || break; \
	  openssl base64 -d -A -in "$$tmpd/c.b64" -out "$$tmpd/c.der"; \
	  fp=`openssl x509 -inform DER -in "$$tmpd/c.der" -noout \
	        -fingerprint -sha1 | sed 's/.*=//'`; \
	  if [ "$$fp" = "$$signer" ]; then match=yes; break; fi; \
	  i=`expr $$i + 1`; \
	done; \
	if [ "$$match" != yes ]; then \
	  echo "ios/Makefile: the signing certificate is not in the" >&2; \
	  echo "  embedded provisioning profile, so this bundle will be" >&2; \
	  echo "  rejected on upload.  Signed by SHA-1 $$signer;" >&2; \
	  echo "  the profile lists $$i certificate(s), none matching." >&2; \
	  echo "  A development certificate against an App Store" >&2; \
	  echo "  profile is the usual cause.  Compare against" >&2; \
	  echo "  security find-identity -v -p codesigning." >&2; \
	  exit 1; \
	fi; \
	echo "ios/Makefile: signing certificate matches the profile."

## Extract the provisioning profile's Entitlements dict to stdout
## as XML plist, ready to redirect into a file and pass back via
## DEVICE_ENTITLEMENTS=.  The dict is the complete entitlements
## file -- it already carries application-identifier,
## com.apple.developer.team-identifier, keychain-access-groups, and
## any capability entitlement provisioned for the App ID.  Apple's
## signing engine (libsecurity_codesigning/lib/signer.cpp) does not
## merge or augment whatever is passed via --entitlements, so this
## extraction is the only input needed.
##
## Inspection commands (Apple-documented): security cms -D -i ...
## is QA1798's documented way to decode a provisioning profile.  Its
## output goes to a temporary file rather than down a pipe, because
## PlistBuddy seeks within the file it reads and so cannot take one:
## given /dev/stdin it reports "Cannot parse a NULL or zero-length
## data" however much the pipe holds.
.PHONY: device-entitlements-template
device-entitlements-template:
	@test -n "$(PROVISIONING_PROFILE)" || { \
	  echo "Set PROVISIONING_PROFILE=path/to/Profile.mobileprovision"; \
	  exit 2; }
	@set -e; \
	tmp=`mktemp -t emacs-provision`; \
	trap 'rm -f "$$tmp"' 0 1 2 3 15; \
	security cms -D -i "$(PROVISIONING_PROFILE)" > "$$tmp"; \
	test -s "$$tmp" || { \
	  echo "Could not decode $(PROVISIONING_PROFILE)."; \
	  echo "  Expected a provisioning profile, which is CMS-signed;"; \
	  echo "  check the path and that the file is not truncated."; \
	  exit 1; }; \
	/usr/libexec/PlistBuddy -x -c "Print :Entitlements" "$$tmp"

## Package the bundle as an .ipa: a zip archive whose top level is
## Payload/Emacs.app.  This is the container format App Store
## Connect ingestion and TestFlight expect; upload it with Apple's
## Transporter.  ditto is Apple's archiver and preserves symlinks,
## permissions and extended attributes that a bare zip can drop --
## important because the codesign seal covers bundle contents.
## Depends on the sign target, which always runs, so passing
## CODESIGN_IDENTITY here signs the bundle that actually gets
## packaged.  With no identity the .ipa is unsigned, which is still
## useful for local inspection but is not uploadable.
.PHONY: ipa
ipa: sign
	rm -rf "$(abs_builddir)/Payload" "$(abs_builddir)/Emacs.ipa"
	$(MKDIR_P) "$(abs_builddir)/Payload"
	cp -R "$(ios_appdir)" "$(abs_builddir)/Payload/"
	( cd "$(abs_builddir)" && \
	  ditto -c -k --keepParent Payload Emacs.ipa )
	rm -rf "$(abs_builddir)/Payload"
	@echo "ios/Makefile: wrote $(abs_builddir)/Emacs.ipa"

## Fallback rule for $(ios_emacs_binary): make -C cross all is what
## produces this file from the *.ios artifacts.  If it's missing we
## emit a diagnostic that points at the correct top-level entry point
## rather than make's default "no rule to make target" message.
$(ios_emacs_binary):
	@echo "ios/Makefile: cannot find iOS-targeted emacs binary at"
	@echo "  $(ios_emacs_binary)"
	@echo ""
	@echo "Build it via 'make -C .. ios' from the top-level build"
	@echo "directory (which runs 'make -C cross all' before assembling"
	@echo "the bundle), or run 'make -C ../cross all' directly."
	@exit 1

## Emacs.base/Info.plist is generated by configure (see
## AC_CONFIG_FILES in configure.ac); no rule needed here.

## Self-regeneration: without this rule, a git pull that changes
## Makefile.in leaves the generated Makefile stale until the next
## configure run -- and bundle-step fixes (e.g. the ibtool launch-
## screen compile) silently fail to take effect.  Standard
## config.status pattern used by every other subdirectory.
Makefile: $(srcdir)/Makefile.in $(abs_top_builddir)/config.status
	cd $(abs_top_builddir) && $(SHELL) ./config.status ios/Makefile

## Same staleness hazard as the Makefile itself: the generated
## Info.plist is a config.status product, and pulls that change
## Info.plist.in (UIDeviceFamily, bundle id, ...) must reach the
## assembled bundle without requiring a manual reconfigure.
Emacs.base/Info.plist: $(srcdir)/Emacs.base/Info.plist.in \
                       $(abs_top_builddir)/config.status
	cd $(abs_top_builddir) && \
	  $(SHELL) ./config.status ios/Emacs.base/Info.plist

.PHONY: clean distclean bootstrap-clean maintainer-clean
clean:
	rm -rf $(ios_appdir)

distclean: clean
	rm -f Makefile Emacs.base/Info.plist

bootstrap-clean maintainer-clean: distclean

### Makefile.in ends here
